# ============================================
# VADODARA SMART CITY TELEMETRY SYSTEM (.env.example)
# Copy this file to .env and configure your values
# ============================================

# Backend FastAPI Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
PORT=8000

# YOLO Real-Time Vision & Stream Server
YOLO_STREAM_HOST=127.0.0.1
YOLO_STREAM_PORT=9000

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Supabase Cloud Database Credentials & Telemetry Sync
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Vite Frontend Supabase Compatibility
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Local Database Configuration
DATABASE_PATH=database/smart_city.db

# Frontend Vite Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_YOLO_STREAM_URL=http://127.0.0.1:9000/stream

# IoT Telemetry Ingestion Key
IOT_SECRET_KEY=your-iot-secret-key
